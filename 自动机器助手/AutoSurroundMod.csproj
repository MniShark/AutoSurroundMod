<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- 手动引用游戏主程序集 -->
    <Reference Include="Stardew Valley">
      <HintPath>E:\SteamLibrary\steamapps\common\Stardew Valley\Stardew Valley.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- 手动引用 SMAPI 主程序集 -->
    <Reference Include="StardewModdingAPI">
      <HintPath>E:\SteamLibrary\steamapps\common\Stardew Valley\StardewModdingAPI.exe</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- ModBuildConfig 用于处理其他依赖（如 MonoGame） -->
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0" />
  </ItemGroup>
</Project>